DOCUMENTS_FOLDER=./data/documents
VECTOR_DB_PATH=./data/vector_db
COLLECTION_NAME=documents

# SQLite file for user accounts, sessions, and saved chat history
DB_PATH=./data/app.db
# How long a login stays valid before the user must sign in again
SESSION_TTL_HOURS=336

# --- Answer providers -------------------------------------------------------
# Tried left to right. When one is rate limited or out of quota the next one
# answers. Providers with a blank API key are skipped automatically, so you can
# run with any subset (or reorder to change which is preferred).
LLM_PROVIDERS=groq,openrouter,anthropic

# Groq - free tier available. Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter - key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Claude - last resort in the default chain. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
CHAT_MODEL=claude-sonnet-4-6

# Per-provider request budget; a stalled provider hands over after this
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# Local, on-device embedding model (no API key needed, no cost)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5

# Largest single file the /api/documents/upload endpoint will accept
MAX_UPLOAD_MB=50

# --- OCR (image -> text) ----------------------------------------------------
# Runs locally via RapidOCR - no API calls, no cost, works offline.
# Set false to reject image uploads entirely.
OCR_ENABLED=true
# Detected lines below this confidence are discarded as noise (0.0 - 1.0)
OCR_MIN_CONFIDENCE=0.5
